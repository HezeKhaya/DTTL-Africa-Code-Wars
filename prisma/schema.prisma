generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Challenge {
  id          BigInt       @id(map: "challenge_pkey") @default(autoincrement())
  name        String       @db.VarChar
  slug        String       @db.VarChar
  order       Int          @default(0) @db.SmallInt
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  level       Int          @default(1) @db.SmallInt
  value       Int          @default(1) @db.SmallInt
  event_id    String       @db.Uuid
  event       Event        @relation(fields: [event_id], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@unique(name: "challengeOrder", [event_id, order])
  @@unique(name: "challengeName", [event_id, name])
  @@unique(name: "challengeSlug", [event_id, slug])
  @@map("challenges")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Event {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  update_at  DateTime    @default(now()) @db.Timestamptz(6)
  created_by String      @db.Uuid
  title      String      @db.VarChar
  banner_url String?     @db.VarChar
  start_date DateTime    @db.Date
  start_time DateTime    @db.Timetz(6)
  end_time   DateTime    @db.Timetz(6)
  blurb      String?     @db.VarChar
  challenges Challenge[]
  user       User        @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teams      Team[]

  @@unique([title])
  @@map("events")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Submission {
  id                BigInt    @id @default(autoincrement())
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  challenge_id      BigInt
  team_id           String    @db.Uuid
  verified          Boolean   @default(false)
  submitted_by      String?   @db.Uuid
  verified_by       String?   @db.Uuid
  challenge         Challenge @relation(fields: [challenge_id], references: [id], onDelete: Cascade)
  submitted_by_user User?     @relation("submissions_submitted_by_users", fields: [submitted_by], references: [id])
  team              Team      @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  verified_by_user  User?     @relation("submissions_verified_by_users", fields: [verified_by], references: [id])

  @@unique([challenge_id, team_id])
  @@map("submissions")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Team {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String       @unique
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  updated_at  DateTime     @default(now()) @db.Timestamp(6)
  created_by  String       @db.Uuid
  event_id    String?      @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissions Submission[]
  user        User         @relation(fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  event       Event?       @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user_teams  UserTeam[]

  @@unique(name: "teamName", [event_id, name])
  @@map("teams")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model UserTeam {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  team_id    String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
  role       Role     @default(member)
  team       Team     @relation(fields: [team_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, team_id])
  @@map("user_teams")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model User {
  id                    String       @id @db.Uuid
  full_name             String?
  email                 String?      @unique
  avatar_url            String?
  created_at_at         DateTime     @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at            DateTime     @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  is_admin              Boolean      @default(false)
  events                Event[]
  submitted_submissions Submission[] @relation("submissions_submitted_by_users")
  verified_submissions  Submission[] @relation("submissions_verified_by_users")
  teams                 Team[]
  user_teams            UserTeam[]

  @@map("users")
}

/// This enum is commented in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
enum Role {
  captain
  member

  @@map("role")
}
